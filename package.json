{
  "name": "daum-public-housing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-information.mjs --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:home": "node --import tsx --test scripts/test-home-discovery.ts",
    "test:insight": "node --import tsx --test scripts/test-insight.ts scripts/test-neighborhood-sources.ts",
    "test:catalog": "node --import tsx --test scripts/test-housing-catalog.ts",
    "test:data": "node --test scripts/test-data-quality.mjs && node --import tsx --test scripts/test-listing-accuracy.ts",
    "sync:lh": "node --env-file=.env.local scripts/sync-lh-api.mjs && node scripts/enrich-complexes.mjs && node scripts/extract-supply-from-md.mjs && node --env-file=.env.local scripts/geocode-missing-coords.mjs",
    "test:auto": "node --import tsx --test scripts/test-auto-prices.ts",
    "sync:auto": "node --import tsx scripts/auto-extract.ts",
    "sync:materials": "node --import tsx scripts/collect-notice-materials.ts",
    "test:materials": "node --test scripts/test-notice-materials.mjs",
    "sync:documents": "node --import tsx scripts/download-notice-files.ts",
    "sync:information": "node --import tsx scripts/collect-pending-information.ts",
    "watch:information": "node scripts/watch-information.mjs",
    "sync:api-first": "node --env-file-if-exists=.env.local scripts/sync-api-first.mjs",
    "sync:building-demo": "node --env-file-if-exists=.env.local scripts/build-dongtan-model.mjs --refresh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ai-sdk/react": "^3.0.184",
    "@anthropic-ai/sdk": "^0.104.1",
    "@langfuse/otel": "^5.9.1",
    "@next/third-parties": "^16.2.4",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/blob": "^2.4.0",
    "ai": "^6.0.182",
    "exceljs": "^4.4.0",
    "maplibre-gl": "6.16.0",
    "next": "16.2.4",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.61.1",
    "puppeteer-core": "^25.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
