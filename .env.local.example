# Naver Cloud Platform > Application > Client ID
# https://console.ncloud.com — Maps 서비스 등록 후 도메인 허용 필요
NEXT_PUBLIC_NAVER_MAPS_CLIENT_ID=

# Naver Cloud Maps Geocoding (REST) - 서버 사이드 (scripts/geocode-lh-naver.mjs)
# NCP Application 의 Client ID / Client Secret. (서버 IP 허용 필요)
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# 공공데이터포털 마이홈포털 공공주택 모집공고 조회 서비스 (HWSPR02)
# https://www.data.go.kr/data/15110581/openapi.do
# Decoded 형태로 저장 (스크립트가 URL 인코딩 알아서 처리)
DATA_GO_KR_KEY=

# 어드민 검수 페이지 (/admin/review) 접근 비밀번호.
ADMIN_PASSWORD=
# 어드민 사이드바에 표시될 사용자 이름 (이메일도 OK). 없으면 "운영자" 로 표시.
ADMIN_NAME=

# 어드민 검수 저장 — 배포(Vercel)에선 fs 가 read-only 라 GitHub Contents API 로
# lib/manual-overrides.json 을 커밋 → 자동 재배포로 메인앱 반영. 로컬 dev 는 토큰 없이 fs 직접 write.
# 토큰은 repo contents write 권한 (fine-grained PAT 권장). Vercel 환경변수에만 등록.
GITHUB_TOKEN=
# 선택 — 기본값 bobbypark-axz/home, main.
GITHUB_REPO=
GITHUB_BRANCH=

# Solar(Upstage) — 공고문 파싱/임베딩/추출. https://console.upstage.ai
SOLAR_API_KEY=
SOLAR_BASE_URL=https://api.upstage.ai/v1
# 어드민 PDF 자동 추출 모델 (선택). 기본: solar-open2-260528 (reasoning — 정확도↑, 호출 수십 초).
SOLAR_EXTRACT_MODEL=

# Anthropic Claude 직접 API 키 (chat 챗봇 + extract-eligibility 자격추출).
# 이전엔 BIZROUTER 프록시 사용했으나 중단되어 직접 호출로 전환.
# sk-ant-api03-... 형식. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 모델 ID (선택). 기본: chat=claude-sonnet-4-6, extract=claude-haiku-4-5
ANTHROPIC_MODEL=

# VWorld 지오코더 2.0 API 키 (국토교통부, 무료). 주소→좌표 변환.
# scripts/geocode-dundeon.mjs, enrich-lh-page-coords.mjs 에서 사용.
# https://www.vworld.kr → 인증키 발급 → 지오코더 API
VWORLD_API_KEY=
