# Vercel deploy package 에서 제외 — 함수 번들 size 절감 + 빌드 속도 ↑
# (Vercel 이 자체적으로 npm install 하니까 node_modules 도 제외)
node_modules
.next/cache

# 큰 로컬 자산 — 모두 Vercel Blob 으로 이전됨
public/lh-covers/
lib/notice-embeddings/

# 런타임에 안 쓰는 데이터
# notice-texts 는 md 본문만 제외 — _meta.json(224KB)은 lh-adapter 가
# 공고문 PDF URL(fileid) 구성에 import 하므로 포함 필수 (개선안1차 M2).
# 디렉토리 통째(lib/notice-texts/) 제외하면 ! 재포함이 안 먹어 contents 패턴 사용.
lib/notice-texts/*
!lib/notice-texts/_meta.json
lib/lh-complexes.json
lib/myhome-all-notices.json
lib/myhome-rental-notices.json
lib/myhome-sale-notices.json
_prototype/

# 빌드 / sync 도구
scripts/
docs/
*.progress.json
.cache/
